# ==========================================================
# NUNES IndiaMART Product Automation V2.4
# SETUP.bat copies this template to the PRIVATE per-PC path:
# %LOCALAPPDATA%\NUNES_INDIAMART_AUTOMATION\config\.env
# V2.4 does NOT write secrets into the shared project/NAS folder.
# ==========================================================

APP_HOST=127.0.0.1
APP_PORT=5077

# Local Ollama / Qwen
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=120

# Browser
BROWSER_CHANNEL=chrome
PUBLIC_HEADLESS=true
PUBLIC_SCAN_RESULTS=4
PUBLIC_RESULT_WAIT_MS=900

# IndiaMART seller posting
INDIAMART_URL=https://seller.indiamart.com/product/manageproducts/
PUBLISH_MODE=review
# Optional override. If omitted, login state is stored under:
# %LOCALAPPDATA%\NUNES_INDIAMART_AUTOMATION\runtime\indiamart_storage_state.json

# PDF
PDF_TEMPLATE_PATH=assets/template.pdf


# Google Sheet direct-link automation (no Apps Script token required for loading products)
GOOGLE_SHEET_MODE=direct
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1iGpbKroGTez2HNq0ps7shzn0OMvASn9-67UBPdogiJw/edit?usp=sharing
GOOGLE_SHEET_NAME=final sheet

# Optional Google Sheet Apps Script bridge
# Best method: configure these in the website FROM THE SERVER PC.
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# Friendly startup login gate / existing Chrome account reconnect
INDIAMART_AUTO_CONNECT=true
INDIAMART_CHROME_PROFILE_BRIDGE=true
CHROME_PROFILE_DIRECTORY=auto
